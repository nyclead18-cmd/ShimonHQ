+{% extends "base.html" %}
+{% block title %}OS · HQ{% endblock %}
+{% block body %}
+<div class="wrap wide">
+<header class="top">
+  <div class="brandside">
+    {% if has_logo %}<img class="hqlogo" src="{{ url_for('static', filename='logo.png') }}?v={{ css_v }}" alt="">{% endif %}
+    <div>
+      <div class="eyebrow">{{ pretty }}</div>
+      <h1>Shimon OS</h1>
+    </div>
+  </div>
+  <div class="right">
+    <nav class="tabs">
+      <a class="tab on" href="{{ url_for('os_view') }}">OS</a>
+      <a class="tab" href="{{ url_for('today_view') }}">Today</a>
+      <a class="tab" href="{{ url_for('board') }}">Board</a>
+      <a class="tab" href="{{ url_for('briefing_view') }}">Brief</a>
+      {% if has_cal %}<a class="tab" href="{{ url_for('calendar_view') }}">Calendar</a>{% endif %}
+      <a class="tab" href="{{ url_for('joel_view') }}">Review</a>
+      <a class="tab" href="{{ url_for('pulse_view') }}">Pulse</a>
+    </nav>
+    <a class="logout" href="{{ url_for('account_view') }}">{{ session.get('name') or 'Account' }}</a>
+    <a class="logout" href="{{ url_for('logout') }}">Sign out</a>
+  </div>
+</header>
+
+<style>
+  .oswrap{display:grid;grid-template-columns:repeat(7,minmax(230px,1fr));gap:12px;overflow-x:auto;padding-bottom:8px;scroll-snap-type:x proximity}
+  .oslane{scroll-snap-align:start;min-width:230px}
+  .oslane .sec-head h2{font-size:1rem}
+  .osrow{padding:8px 10px;border-top:1px solid rgba(0,0,0,.06);line-height:1.3}
+  .osrow:first-child{border-top:0}
+  .osrow .t{font-weight:600}
+  .osrow .m{font-size:.82rem;opacity:.75;margin-top:2px}
+  .osrow .m b{font-weight:600;opacity:1}
+  .osrow.over .m .d{color:#A33B2E;font-weight:700}
+  .osmore{font-size:.82rem;opacity:.7;padding:6px 10px}
+  .dec{background:rgba(107,74,138,.06);border-radius:8px;margin:6px;padding:8px 10px}
+  .dec .q{font-weight:600}
+  .dec .kv{font-size:.82rem;margin-top:3px}
+  .dec .kv b{display:inline-block;min-width:82px;opacity:.7;font-weight:600}
+  .dec form{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}
+  .dec input[type=text]{flex:1;min-width:120px;padding:5px 8px;border:1px solid rgba(0,0,0,.15);border-radius:6px}
+  .dec button{padding:5px 10px;border-radius:6px;border:0;background:#1F3A5F;color:#fff;cursor:pointer}
+  .dec button.alt{background:#8A671D}
+  .osstats{display:flex;gap:10px;flex-wrap:wrap;margin:10px 0 14px}
+  .osstats a{text-decoration:none;color:inherit;background:rgba(0,0,0,.04);border-radius:10px;padding:8px 12px;min-width:90px}
+  .osstats .num{font-size:1.4rem;font-weight:700;line-height:1}
+  .osstats .lbl{font-size:.75rem;opacity:.7;text-transform:uppercase;letter-spacing:.04em}
+  .osstats a.alarm{background:rgba(163,59,46,.12)}
+  @media (max-width:700px){.oswrap{grid-template-columns:repeat(7,84vw)}.oslane{min-width:84vw}}
+</style>
+
+<div class="osstats">
+  {% for b in order %}
+  <a href="#os-{{ b }}"{% if b == 'PROBLEMS' and lanes[b] %} class="alarm"{% endif %}>
+    <div class="num">{{ lanes[b]|length }}</div><div class="lbl">{{ labels[b] }}</div></a>
+  {% endfor %}
+</div>
+
+<div class="oswrap">
+{% for b in order %}
+<section class="card oslane" id="os-{{ b }}" style="--sa: {{ colors[b] }}">
+  <div class="sec-head"><h2><span class="dot"></span>{{ labels[b] }}</h2>
+    <span class="counts">{{ lanes[b]|length }}</span></div>
+  {% set rows = lanes[b] %}
+  {% if not rows %}
+    <p class="caveat">{% if b == 'PROBLEMS' %}Nothing stuck.{% elif b == 'DECIDE' %}Nothing waiting on you.{% elif b == 'JOEL' %}Nothing for Joel.{% else %}&mdash;{% endif %}</p>
+  {% endif %}
+  {% for it in rows[:12] %}
+    {% set dfor = decfor(it.decision_for, it.title) %}
+    {% if b in ('DECIDE', 'JOEL') %}
+    <div class="dec">
+      <div class="q"><a href="{{ url_for('board') }}#item-{{ it.id }}">{{ it.title|replace('DECIDE: ','')|replace('JOEL: ','')|replace('YECHIEL: ','') }}</a></div>
+      {% if it.decision_q or it.note %}<div class="kv"><b>Decision</b> {{ it.decision_q or it.note }}</div>{% endif %}
+      {% if it.decision_rec %}<div class="kv"><b>Recommend</b> {{ it.decision_rec }}</div>{% endif %}
+      {% if it.decision_cost %}<div class="kv"><b>Cost</b> {{ it.decision_cost }}</div>{% endif %}
+      {% if it.due_date %}<div class="kv"><b>Deadline</b> {{ it.due_date[5:7]|int }}/{{ it.due_date[8:10]|int }}</div>{% endif %}
+      {% if it.decision_nothing %}<div class="kv"><b>If nothing</b> {{ it.decision_nothing }}</div>{% endif %}
+      <div class="kv"><b>Decider</b> {{ {'me':'Shimon','joel':'Joel','yechiel':'Yechiel','other':'Other'}.get(dfor, dfor) }}{% if it.proj_title %} &middot; {{ it.proj_title }}{% endif %}</div>
+      <form method="post" action="{{ url_for('item_decide', item_id=it.id) }}">
+        <input type="hidden" name="back" value="{{ url_for('os_view') }}">
+        <button type="submit" name="result" value="approved">Approve</button>
+        <input type="text" name="result" placeholder="Other: one line" dir="auto">
+        <button type="submit" class="alt">Save</button>
+      </form>
+    </div>
+    {% else %}
+    <div class="osrow{% if it.due_date and it.due_date < today_iso %} over{% endif %}">
+      <div class="t"><a href="{{ url_for('board') }}#item-{{ it.id }}">{{ it.title }}</a></div>
+      <div class="m">
+        {% if b == 'DELEGATE' %}<b>&rarr; {{ it.delegate_to }}</b>
+        {% elif it.waiting_on %}<b>{{ it.waiting_on }}</b>{% endif %}
+        {% if it.follow_up_at and b in ('WAITING','TODAY','PROBLEMS') %} &middot; chase <span class="d">{{ it.follow_up_at[5:7]|int }}/{{ it.follow_up_at[8:10]|int }}</span>{% if it.follow_up_count %} (x{{ it.follow_up_count }}){% endif %}{% endif %}
+        {% if it.due_date %} &middot; due <span class="d">{{ it.due_date[5:7]|int }}/{{ it.due_date[8:10]|int }}</span>{% endif %}
+        {% if it.proj_title %} &middot; {{ it.proj_title }}{% elif it.sec_title %} &middot; {{ it.sec_title }}{% endif %}
+      </div>
+    </div>
+    {% endif %}
+  {% endfor %}
+  {% if rows|length > 12 %}<div class="osmore">+{{ rows|length - 12 }} more on the <a href="{{ url_for('board') }}">board</a></div>{% endif %}
+</section>
+{% endfor %}
+</div>
+
+<p class="meta noprint tdhint">Seven columns, one copy of each task. A task waits with a chase date or it isn't waiting;
+two chases and it becomes a problem. Decisions clear with one tap.</p>
+</div>
+{% endblock %}
